# Copy this file to .env and fill in YOUR values. Never commit .env. Never paste keys into chat.
# PAPER / SANDBOX ONLY.

# Webull OpenAPI (primary): app key + secret from the Webull developer portal
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# Webull paper/sandbox account id (the engine refuses to start on anything else)
WEBULL_ACCOUNT_ID=
WEBULL_ENV=sandbox

# Alpaca (history for replay, optional backup): PAPER keys only
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

WEBULL_PAPER_ACCOUNT_NUMBER=
WEBULL_PAPER_ACCOUNT_CLASS=
WEBULL_SANDBOX_ACCOUNT_ATTESTED=

ALPACA_DATA_FEED=
DATA_PROVIDER=

# Optional extras
MASSIVE_API_KEY=
DATABENTO_API_KEY=
FMP_API_KEY=
SEC_USER_AGENT=
